{
  "openapi": "3.1.0",
  "info": {
    "title": "SendGrid selected operations",
    "version": "0.1.0",
    "description": "Reviewed local connector bindings for manual API import. No provider credentials are included; authentication and hosted execution require separate configuration and tests."
  },
  "servers": [
    {
      "url": "https://api.sendgrid.com/v3"
    }
  ],
  "paths": {
    "/templates": {
      "get": {
        "operationId": "sendgrid_list_templates",
        "summary": "Read the account transactional templates.",
        "parameters": [],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      },
      "post": {
        "operationId": "sendgrid_create_template",
        "summary": "Create an empty dynamic template shell. No version is activated and no message is sent.",
        "parameters": [],
        "x-pipmcp-read-only": false,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "generation": {
                    "const": "dynamic",
                    "default": "dynamic"
                  }
                },
                "required": [
                  "name",
                  "generation"
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "providerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "providerAuth": []
    }
  ]
}
